# Copy to .env and fill in. .env is gitignored.

# --- Prava (sandbox) — card leg ---
PRAVA_PK_TEST=pk_test_...
PRAVA_SK_TEST=sk_test_...

# --- OpenAI — the agent's brain (planning + answering). $100 hackathon credit. ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- x402 settle leg ---
# Float wallet private key (Base Sepolia USDC for the testnet demo). Optional:
# defaults to ~/.predge-x402/buyer.json if unset. Keep out of git.
# FLOAT_PRIVATE_KEY=0x...

# Point the agent at a Predge instance (default = live prod on Base mainnet):
# PREDGE_BASE=http://localhost:4021        # local Base Sepolia testnet
X402_NETWORK=base-sepolia

# --- bridge policy ---
BRIDGE_AUTO_THRESHOLD_USDC=0.01
BRIDGE_FEE_USDC=0
PORT=8899
